# Machine-specific values for the scripts. Copy to secrets.env (gitignored)
# and fill in. Never commit secrets.env.

# The watch to install on: xcrun devicectl list devices
WATCH_UDID="00000000-000000000000000A"

# Apple Developer team ID (Membership details, or the suffix in parentheses
# of your Apple Distribution certificate name).
DEVELOPMENT_TEAM="XXXXXXXXXX"
